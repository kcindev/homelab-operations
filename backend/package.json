{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "tsc",
    "db:check": "tsx --env-file-if-exists=.env src/scripts/db-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/db-migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0"
  }
}
